# Directus API (required)
# Local dev: use your computer's LAN IP when testing on a physical phone (not localhost)
# Shared/APK build: use your Railway URL, e.g. https://carpool-directus.up.railway.app
EXPO_PUBLIC_DIRECTUS_URL=http://192.168.1.25:8055
EXPO_PUBLIC_DIRECTUS_TOKEN=your-directus-static-token-here

# After clearing Directus or fresh install, run:
#   npm run setup-directus-fields
#   npm run setup-notifications

# Google Maps (optional – also set in app.json for native maps)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Resend email OTP (optional – only for email verification)
EXPO_PUBLIC_RESEND_API_KEY=your-resend-api-key
