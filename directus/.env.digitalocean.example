# App Platform: use the bound Postgres component (HOSTNAME/PORT/... vars)
# Or paste a Managed Postgres connection string:
# DB_CLIENT=pg
# DB_CONNECTION_STRING=postgresql://user:pass@host:25060/directus?sslmode=require

DB_CLIENT=pg

# After first deploy, set this to your public HTTPS URL, e.g.
# https://carpool-directus-xxxxx.ondigitalocean.app
PUBLIC_URL=https://carpool-directus.ondigitalocean.app

STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=/directus/uploads

CORS_ENABLED=true
CORS_ORIGIN=*
WEBSOCKETS_ENABLED=true
