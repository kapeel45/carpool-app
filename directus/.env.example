# ----------------------------------------------------------------------------
# Directus on Railway — set these as Variables on the Directus service.
# Do NOT commit real values. This file only documents what is required.
# ----------------------------------------------------------------------------

# Security (generate random strings, e.g. `openssl rand -hex 32`)
KEY=replace-with-random-string
SECRET=replace-with-random-string

# First admin login (used to create your static token afterwards)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-strong-password

# Database — add a Postgres plugin in Railway, then reference it:
DB_CLIENT=pg
DB_CONNECTION_STRING=${{Postgres.DATABASE_URL}}

# Public URL — Railway exposes the domain; Directus needs the full https URL
PUBLIC_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

# File uploads — attach a Railway Volume mounted at /directus/uploads
STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=/directus/uploads

# CORS (needed if you also run the web build of the app)
CORS_ENABLED=true
CORS_ORIGIN=*

# Optional: realtime
WEBSOCKETS_ENABLED=true
